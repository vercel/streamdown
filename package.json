{
  "name": "streamdown-monorepo",
  "private": true,
  "scripts": {
    "bench": "turbo run bench",
    "bench:ui": "turbo run bench:ui",
    "build": "turbo run build",
    "build:packages": "pnpm build --filter streamdown --filter @streamdown/math --filter @streamdown/code --filter @streamdown/cjk --filter @streamdown/mermaid",
    "bump-deps": "npx npm-check-updates -u --deep -x \"recharts\" && pnpm i",
    "changeset": "changeset",
    "changeset:publish": "pnpm build && changeset publish",
    "changeset:version": "changeset version",
    "check": "ultracite check",
    "check-types": "turbo run check-types",
    "dev": "turbo run dev",
    "fix": "ultracite fix",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:ui": "turbo run test:ui"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.5",
    "@changesets/cli": "^2.31.1",
    "turbo": "^2.11.13",
    "typescript": "5.9.3",
    "ultracite": "7.2.4"
  },
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "lodash-es": "^4.18.1",

      "@modelcontextprotocol/server@>=2.0.0 <2.3.0": "^2.3.0",
      "brace-expansion@>=5.0.0 <5.0.12": "^5.0.12",
      "browserslist@<4.28.7": "^4.28.7",
      "dompurify@<3.4.17": "^3.4.17",
      "image-size@<2.0.3": "^2.0.3",
      "js-yaml@>=3.0.0 <3.15.2": "^3.15.2",
      "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
      "path-to-regexp@>=8.0.0 <8.4.0": "^8.4.0",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "postcss-selector-parser@>=7.0.0 <7.1.6": "^7.1.6",
      "rollup@>=4.0.0 <4.59.0": "^4.59.0",
      "source-map-js@<1.2.2": "^1.2.2",
      "undici@>=4.0.0 <6.29.1": "^6.29.1",
      "uuid@<11.1.1": "^11.1.1",
      "vite": "^7.3.7",
      "ws@>=8.0.0 <8.21.0": "^8.21.0",
      "zod@<4.6.6": "^4.6.6"
    }
  }
}
